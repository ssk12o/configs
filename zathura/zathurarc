# Base colors (deep night background)
set default-bg            "#1a1b26"
set default-fg            "#c0caf5"

# Status bar
set statusbar-bg          "#16161e"
set statusbar-fg          "#a9b1d6"

# Input bar
set inputbar-bg           "#16161e"
set inputbar-fg           "#c0caf5"

# Notification colors
set notification-bg       "#1f2335"
set notification-fg       "#c0caf5"
set notification-error-bg "#f7768e"
set notification-error-fg "#1a1b26"
set notification-warning-bg "#e0af68"
set notification-warning-fg "#1a1b26"

# Highlighting (search, selection)
set highlight-color       "#7aa2f7"
set highlight-fg          "#1a1b26"
set highlight-active-color "#bb9af7"

# Completion (command/search suggestions)
set completion-bg         "#1f2335"
set completion-fg         "#c0caf5"
set completion-highlight-bg "#7aa2f7"
set completion-highlight-fg "#1a1b26"
set completion-group-bg   "#16161e"
set completion-group-fg   "#7dcfff"

# Index (table of contents)
set index-bg              "#1a1b26"
set index-fg              "#c0caf5"
set index-active-bg       "#7aa2f7"
set index-active-fg       "#1a1b26"

# Recolor (for PDFs - improves readability)
set recolor               "true"
set recolor-lightcolor    "#1a1b26"
set recolor-darkcolor     "#c0caf5"

# Smooth visuals
set smooth-scroll         "true"
set scroll-step           90

# Padding (modern spacing feel)
set page-padding          8

# Window title
set window-title-basename "true"

# Selection (copy text)
set selection-clipboard   "clipboard"

# Optional: invert images off (keeps images natural)
set recolor-keephue       "true"
